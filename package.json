{
  "name": "dsh-read-it-later",
  "version": "0.2.3",
  "private": false,
  "type": "module",
  "description": "把每一轮对话发到飞书 / 微信 / Telegram / Discord / 钉钉：稍后读、预处理后自动发送、跨设备会话接力。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "feishu",
    "weixin",
    "telegram",
    "discord",
    "dingtalk",
    "share",
    "im"
  ],
  "main": "index.js",
  "icon": "./assets/coffee-cup.png",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./assets/coffee-cup.png",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "qrcode": "^1.5.4"
  },
  "license": "MIT",
  "author": "jes-phd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jes-phd/dsh-read-it-later.git"
  },
  "homepage": "https://github.com/jes-phd/dsh-read-it-later#readme",
  "bugs": {
    "url": "https://github.com/jes-phd/dsh-read-it-later/issues"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/",
    "assets/illus-*.png",
    "assets/coffee-cup.png",
    "assets/social-preview.png",
    "share-extract.py",
    "zip-files.py",
    "monitor-scan.py",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node tests/smoke-client.mjs && node tests/smoke-rpc.mjs && node tests/smoke-log.mjs",
    "prepublishOnly": "node tests/smoke-client.mjs"
  }
}
